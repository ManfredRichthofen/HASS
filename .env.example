# Home Assistant instance URL (reachable from your browser)
# LAN: http://homeassistant.local:8123
# Or your Nabu Casa / reverse-proxy URL
VITE_HA_URL=http://homeassistant.local:8123

# Optional Music Assistant server URL (reachable from this device).
# The app auto-uses your Home Assistant Music Assistant integration when possible.
# Only set these if auto-discovery cannot reach the MA API (e.g. reverse-proxy).
# VITE_MA_URL=http://homeassistant.local:8095
# Optional fallback long-lived token (MA → Settings → Profile):
# VITE_MA_TOKEN=
